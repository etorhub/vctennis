# Astro DB - LibSQL / Turso (required for npm run dev / build with --remote)
# Create with: turso auth login && npm run db:setup
ASTRO_DB_REMOTE_URL=""
ASTRO_DB_APP_TOKEN=""

# Better Auth (required) - https://www.better-auth.com/docs/installation#set-environment-variables
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4321"

# Resend (required for verification + password-reset emails) - https://resend.com/api-keys
RESEND_API_KEY=""
# Optional verified sender (defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL="Vinya Canadell Tennis <onboarding@resend.dev>"
