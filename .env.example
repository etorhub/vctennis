# Astro DB - LibSQL / Turso (required for npm run dev / build with --remote)
# Create with: turso auth login && npm run db:setup
ASTRO_DB_REMOTE_URL=""
ASTRO_DB_APP_TOKEN=""

# Better Auth (required) - https://www.better-auth.com/docs/installation#set-environment-variables
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4321"

# Feature flag: set to "true" once you have a verified Resend sending domain.
# When not "true", all email sending is skipped (verification, password reset, booking
# confirmation/reminder) and registration auto-activates accounts with no verification step.
EMAILS_ENABLED="false"

# Resend (only required when EMAILS_ENABLED="true") - https://resend.com/api-keys
RESEND_API_KEY=""
# From address. onboarding@resend.dev can only email YOUR Resend account address.
# For real signups, verify a domain at https://resend.com/domains and use it here.
RESEND_FROM_EMAIL="Vinya Canadell Tennis <onboarding@resend.dev>"
# Optional. Reply-To address for outgoing emails; also used for the reminder's
# List-Unsubscribe header. Leave unset to omit both.
RESEND_REPLY_TO=""

# Shared secret checked by /api/cron/send-reminders - generate with: openssl rand -base64 32
CRON_SECRET=""
