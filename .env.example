# Astro DB - LibSQL / Turso (required for npm run dev / build with --remote)
# Create with: turso auth login && npm run db:setup
ASTRO_DB_REMOTE_URL=""
ASTRO_DB_APP_TOKEN=""

# Better Auth (required) - https://www.better-auth.com/docs/installation#set-environment-variables
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4321"

# Feature flag: set to true once you have a verified Resend sending domain.
# When not true, all email sending is skipped (verification, password reset, booking
# confirmation/reminder) and registration auto-activates accounts with no verification step.
# In a local .env file quotes are optional. In Netlify (and most host UIs) enter the bare
# value true or false — do not include quote characters in the stored value.
EMAILS_ENABLED=false

# Resend (only required when EMAILS_ENABLED=true) - https://resend.com/api-keys
RESEND_API_KEY=""
# From address. onboarding@resend.dev can only email YOUR Resend account address.
# For real signups, verify a domain at https://resend.com/domains and use it here.
RESEND_FROM_EMAIL="Vinya Canadell Tennis <onboarding@resend.dev>"
# Optional. Reply-To address for outgoing emails; also used for the reminder's
# List-Unsubscribe header. Leave unset to omit both.
RESEND_REPLY_TO=""

# Shared secret (Bearer) for /api/cron/send-reminders and /api/cron/metrics.
# Prod HTTP probes run via the Netlify scheduled function health-probe (not this secret
# alone); /api/cron/health-probe exists for manual/Bearer calls. Generate with: openssl rand -base64 32
CRON_SECRET=""

# Grafana Cloud dual-write from emitEvent (optional — leave blank to skip)
# Create an Access Policy with logs:write + metrics:write, then mint a token.
# Stack URLs/users are from your Grafana Cloud portal (Connections → ...).
GRAFANA_CLOUD_TOKEN=""
GRAFANA_LOKI_URL="https://logs-prod-039.grafana.net"
GRAFANA_LOKI_USER="1713865"
GRAFANA_PROM_REMOTE_WRITE_URL="https://prometheus-prod-58-prod-eu-central-0.grafana.net/api/prom/push"
GRAFANA_PROM_USER="3436380"
# Optional override for /api/cron/health-probe (defaults to Netlify URL / BETTER_AUTH_URL)
HEALTH_PROBE_BASE_URL="https://tennisvinyacanadell.cc"
