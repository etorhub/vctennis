---
import { SEO } from "astro-seo";
import Icon from "astro-iconify";
import "@/global.css";
import { SITE_NAME, THEME_COLOR } from "@/lib/config";

interface Props {
  title?: string;
  description?: string;
  bodyClasses?: string;
}

const { t, locale } = Astro.locals;
const {
  title = t("siteName"),
  description = t("tagline"),
  bodyClasses = ""
} = Astro.props;
const fullTitle = title === SITE_NAME || title === t("siteName") ? title : `${title} · ${t("siteName")}`;
---

<!doctype html>
<html
  lang={locale}
  data-theme="tennis"
  x-data={`{ toastMessage: '', toastErrorMessage: '' }`}
  class="bg-base-100"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={t("siteName")} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO
      title={fullTitle}
      description={description}
      openGraph={{
        basic: {
          title: fullTitle,
          type: "website",
          image: "/icons/icon-512.png"
        },
        optional: { description }
      }}
    />
    <slot name="head" />
  </head>
  <body class={`min-h-dvh w-full ${bodyClasses}`}>
    <div
      x-cloak
      x-show="toastMessage"
      x-transition
      class="z-[60] toast toast-top toast-center w-full max-w-sm"
    >
      <div role="alert" class="alert alert-success shadow-lg">
        <Icon pack="lucide" name="check-circle" height={20} width={20} class="shrink-0" />
        <span x-text="toastMessage"></span>
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-circle"
          @click="toastMessage = ''"
          aria-label={t("close")}
        >
          <Icon pack="lucide" name="x" height={16} width={16} />
        </button>
      </div>
    </div>
    <div
      x-cloak
      x-show="toastErrorMessage"
      x-transition
      class="z-[60] toast toast-top toast-center w-full max-w-sm"
    >
      <div role="alert" class="alert alert-error shadow-lg">
        <Icon pack="lucide" name="octagon-alert" height={20} width={20} class="shrink-0" />
        <span x-text="toastErrorMessage"></span>
        <button
          type="button"
          class="btn btn-ghost btn-sm btn-circle"
          @click="toastErrorMessage = ''"
          aria-label={t("close")}
        >
          <Icon pack="lucide" name="x" height={16} width={16} />
        </button>
      </div>
    </div>

    <slot />

    <div
      x-data="pwaInstall"
      x-cloak
      x-show="visible"
      x-transition
      class="fixed inset-x-0 bottom-0 z-[35] border-t border-slate-200 bg-white/95 p-3 shadow-lg backdrop-blur supports-[backdrop-filter]:bg-white/90"
      style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px))"
      role="dialog"
      aria-label={t("installApp")}
    >
      <div class="mx-auto flex w-full max-w-lg items-start gap-3 md:max-w-2xl lg:max-w-7xl">
        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
          <Icon pack="lucide" name="download" height={18} width={18} />
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold leading-tight">{t("installApp")}</p>
          <p class="mt-0.5 text-xs text-slate-600" x-show="canInstall" x-cloak>
            {t("installAppHint")}
          </p>
          <p class="mt-0.5 text-xs text-slate-600" x-show="showIos" x-cloak>
            {t("installAppIosHint")}
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <button
              type="button"
              class="btn btn-primary btn-sm"
              x-show="canInstall"
              x-cloak
              @click="install()"
            >
              {t("install")}
            </button>
            <button type="button" class="btn btn-ghost btn-sm" @click="dismiss()">
              {t("notNow")}
            </button>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
