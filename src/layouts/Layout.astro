---
import { SEO } from "astro-seo";
import Icon from "astro-iconify";
import "@/global.css";
import { SITE_NAME, THEME_COLOR } from "@/lib/config";

interface Props {
  title?: string;
  description?: string;
  bodyClasses?: string;
}

const { t, locale } = Astro.locals;
const {
  title = t("siteName"),
  description = t("tagline"),
  bodyClasses = ""
} = Astro.props;
const fullTitle = title === SITE_NAME || title === t("siteName") ? title : `${title} · ${t("siteName")}`;
---

<!doctype html>
<html
  lang={locale}
  data-theme="tennis"
  x-data={`{ toastMessage: '', toastErrorMessage: '' }`}
  class="bg-base-100"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={t("siteName")} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO
      title={fullTitle}
      description={description}
      openGraph={{
        basic: {
          title: fullTitle,
          type: "website",
          image: "/icons/icon-512.png"
        },
        optional: { description }
      }}
    />
    <slot name="head" />
  </head>
  <body class={`min-h-dvh w-full ${bodyClasses}`}>
    <div
      x-cloak
      x-show="toastMessage"
      x-transition
      class="z-[60] toast toast-top toast-center w-full max-w-sm"
    >
      <div role="alert" class="alert alert-success shadow-lg">
        <Icon pack="lucide" name="check-circle" height={20} width={20} class="shrink-0" />
        <span x-text="toastMessage"></span>
      </div>
    </div>
    <div
      x-cloak
      x-show="toastErrorMessage"
      x-transition
      class="z-[60] toast toast-top toast-center w-full max-w-sm"
    >
      <div role="alert" class="alert alert-error shadow-lg">
        <Icon pack="lucide" name="octagon-alert" height={20} width={20} class="shrink-0" />
        <span x-text="toastErrorMessage"></span>
      </div>
    </div>

    <slot />

    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
