---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";

const { t, user } = Astro.locals;
if (user && !user.disabled) {
  return Astro.redirect("/");
}

const token = Astro.url.searchParams.get("token") ?? "";
const invalidFromQuery = Astro.url.searchParams.get("error") === "INVALID_TOKEN";
const tokenOk = Boolean(token) && !invalidFromQuery;

const messages = {
  errorGeneric: t("errorGeneric"),
  passwordMismatch: t("passwordMismatch"),
  passwordTooShort: t("passwordTooShort")
};
---

<Layout title={t("resetPassword")}>
  <AppHeader title={t("resetPassword")} backHref="/sign-in" />
  <main class="mx-auto max-w-sm px-4 py-8">
    <div
      class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
      x-data={`{
        token: ${JSON.stringify(token)},
        tokenOk: ${JSON.stringify(tokenOk)},
        password: '',
        confirmPassword: '',
        loading: false,
        done: false,
        error: '',
        messages: ${JSON.stringify(messages)},
        async submit() {
          if (!this.tokenOk) return;
          this.loading = true;
          this.error = '';
          try {
            if (this.password.length < 8) {
              throw new Error(this.messages.passwordTooShort);
            }
            if (this.password !== this.confirmPassword) {
              throw new Error(this.messages.passwordMismatch);
            }
            const res = await fetch('/api/auth/reset-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                newPassword: this.password,
                token: this.token
              })
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.message || data.error?.message || this.messages.errorGeneric);
            }
            this.done = true;
          } catch (e) {
            this.error = e.message || this.messages.errorGeneric;
          } finally {
            this.loading = false;
          }
        }
      }`}
    >
      <div x-show="!done">
        <h1 class="mb-1 text-xl font-semibold">{t("resetPassword")}</h1>
        <p class="mb-6 text-sm text-slate-500">{t("tagline")}</p>

        {
          tokenOk ? (
            <div>
              <label class="form-control w-full">
                <div class="label py-1">
                  <span class="label-text">{t("newPassword")}</span>
                </div>
                <input
                  type="password"
                  class="input input-bordered w-full"
                  x-model="password"
                  required
                  minlength="8"
                  autocomplete="new-password"
                />
              </label>
              <label class="form-control mt-3 w-full">
                <div class="label py-1">
                  <span class="label-text">{t("confirmPassword")}</span>
                </div>
                <input
                  type="password"
                  class="input input-bordered w-full"
                  x-model="confirmPassword"
                  required
                  minlength="8"
                  autocomplete="new-password"
                />
              </label>
              <p class="mt-2 text-sm text-error" x-show="error" x-text="error" />
              <button
                type="button"
                class="btn btn-primary mt-4 w-full"
                :disabled="loading || !password || !confirmPassword"
                @click="submit()"
              >
                <span x-show="!loading">{t("resetPassword")}</span>
                <span x-show="loading" x-cloak>
                  {t("loading")}
                </span>
              </button>
            </div>
          ) : (
            <div>
              <p class="text-sm text-error">{t("invalidResetToken")}</p>
              <a href="/sign-in" class="btn btn-primary mt-6 w-full">
                {t("backToSignIn")}
              </a>
            </div>
          )
        }
      </div>

      <div x-show="done" x-cloak class="text-center">
        <p class="text-lg font-medium text-primary">{t("passwordResetDone")}</p>
        <a href="/sign-in" class="btn btn-primary mt-6 w-full">{t("signIn")}</a>
      </div>
    </div>
  </main>
</Layout>
