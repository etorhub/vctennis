---
import { actions } from "astro:actions";
import Icon from "astro-iconify";
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import type { MessageKey } from "@/lib/i18n";
import { DEFAULT_THEME_PREFERENCE, type ThemePreference } from "@/lib/theme";

const { t, user } = Astro.locals;

const deleteResult = Astro.getActionResult(actions.auth.deleteAccount);
if (deleteResult?.data?.success) {
  return Astro.redirect("/");
}

if (!user) return Astro.redirect("/sign-in");

const result = Astro.getActionResult(actions.auth.updateProfile);
const saved = !!result?.data?.success;

const passwordResult = Astro.getActionResult(actions.auth.changePassword);
const passwordChanged = !!passwordResult?.data?.success;
const passwordErrorKey = passwordResult?.error?.message as MessageKey | undefined;
const passwordError = passwordErrorKey
  ? t(passwordErrorKey) !== String(passwordErrorKey)
    ? t(passwordErrorKey)
    : t("errorGeneric")
  : undefined;

const deleteErr = deleteResult?.error?.message;
const deleteErrorMessage = deleteErr
  ? (() => {
      const key = deleteErr as MessageKey;
      return t(key) !== String(key) ? t(key) : t("errorGeneric");
    })()
  : "";

const themeOptions: { value: ThemePreference; label: string; icon: string }[] = [
  { value: "system", label: t("themeSystem"), icon: "monitor" },
  { value: "light", label: t("themeLight"), icon: "sun" },
  { value: "dark", label: t("themeDark"), icon: "moon" }
];
const currentTheme = user.theme ?? DEFAULT_THEME_PREFERENCE;
---

<Layout title={t("settings")}>
  <AppHeader title={t("settings")} backHref="/" />
  {saved && <div x-init={`toastMessage = ${JSON.stringify(t("profileSaved"))}`} class="sr-only" />}
  {
    passwordChanged && (
      <div x-init={`toastMessage = ${JSON.stringify(t("passwordChanged"))}`} class="sr-only" />
    )
  }
  <main class="mx-auto max-w-sm px-4 py-6">
    <a href="/my-bookings" class="btn btn-primary mb-4 w-full">
      {t("myBookings")}
    </a>

    <form
      method="POST"
      action={actions.auth.updateProfile}
      class="flex flex-col gap-4 rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm"
    >
      <label class="form-control w-full">
        <div class="label py-1"><span class="label-text">{t("name")}</span></div>
        <input
          type="text"
          name="name"
          class="input input-bordered w-full"
          value={user.name || ""}
          required
          maxlength="80"
        />
      </label>

      <label class="flex cursor-pointer items-start gap-3 rounded-xl bg-base-200 p-3">
        <input
          type="checkbox"
          name="showName"
          class="checkbox checkbox-primary mt-0.5"
          checked={user.showName !== false}
        />
        <span>
          <span class="font-medium">{t("showName")}</span>
          <span class="mt-0.5 block text-sm text-base-content/60">{t("showNameHelp")}</span>
        </span>
      </label>

      <fieldset class="w-full">
        <legend class="label-text mb-1 block">{t("appearance")}</legend>
        <div class="grid grid-cols-3 gap-2">
          {
            themeOptions.map((option) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="theme"
                  value={option.value}
                  class="peer sr-only"
                  checked={currentTheme === option.value}
                  onchange="window.applyThemePreference && window.applyThemePreference(this.value)"
                />
                <span class="flex flex-col items-center gap-1.5 rounded-xl border-2 border-base-300 bg-base-200 px-2 py-3 text-xs font-medium peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primary">
                  <Icon pack="lucide" name={option.icon} height={20} width={20} />
                  {option.label}
                </span>
              </label>
            ))
          }
        </div>
        <p class="mt-2 text-sm text-base-content/60">{t("appearanceHelp")}</p>
      </fieldset>

      {
        result?.error && (
          <p class="text-sm text-error">{result.error.message}</p>
        )
      }

      <button type="submit" class="btn btn-primary">{t("save")}</button>
    </form>

    <form
      method="POST"
      action={actions.auth.changePassword}
      class="mt-4 flex flex-col gap-4 rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm"
    >
      <h2 class="text-lg font-semibold">{t("changePassword")}</h2>

      <label class="form-control w-full">
        <div class="label py-1"><span class="label-text">{t("currentPassword")}</span></div>
        <input
          type="password"
          name="currentPassword"
          class="input input-bordered w-full"
          required
          autocomplete="current-password"
        />
      </label>

      <label class="form-control w-full">
        <div class="label py-1"><span class="label-text">{t("newPassword")}</span></div>
        <input
          type="password"
          name="newPassword"
          class="input input-bordered w-full"
          required
          minlength="8"
          autocomplete="new-password"
        />
      </label>

      <label class="form-control w-full">
        <div class="label py-1"><span class="label-text">{t("confirmPassword")}</span></div>
        <input
          type="password"
          name="confirmPassword"
          class="input input-bordered w-full"
          required
          minlength="8"
          autocomplete="new-password"
        />
      </label>

      {passwordError && <p class="text-sm text-error">{passwordError}</p>}

      <button type="submit" class="btn btn-primary">{t("changePassword")}</button>
    </form>

    <section class="mt-6 rounded-2xl border border-error/30 bg-base-100 p-6 shadow-sm">
      <h2 class="text-base font-semibold text-error">{t("deleteAccount")}</h2>
      <p class="mt-2 text-sm leading-relaxed text-base-content/70">{t("deleteAccountHelp")}</p>
      <form
        method="POST"
        action={actions.auth.deleteAccount}
        class="mt-4 flex flex-col gap-3"
        onsubmit={`return confirm(${JSON.stringify(t("confirmDeleteAccount"))})`}
      >
        <label class="form-control w-full">
          <div class="label py-1"><span class="label-text">{t("confirmEmail")}</span></div>
          <input
            type="email"
            name="confirmEmail"
            class="input input-bordered w-full"
            autocomplete="email"
            required
            maxlength="320"
            placeholder={user.email}
          />
        </label>
        {
          deleteErrorMessage && (
            <p class="text-sm text-error" role="alert">
              {deleteErrorMessage}
            </p>
          )
        }
        <button type="submit" class="btn btn-error btn-outline w-full">{t("deleteAccount")}</button>
      </form>
    </section>

    <a href="/privacy" class="btn btn-ghost mt-4 w-full">
      {t("privacy")}
    </a>

    <a href="/rules" class="btn btn-ghost mt-2 w-full">
      {t("rules")}
    </a>

    {
      user.role === "admin" && (
        <a href="/admin/users" class="btn btn-outline mt-2 w-full">
          {t("admin")}
        </a>
      )
    }
  </main>
</Layout>
