---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import { db, Bookings as BookingsTable, User } from "astro:db";
import { bookingEnd, effectiveEnd, formatTime, getZonedParts } from "@/lib/time";

const { t, locale } = Astro.locals;

const [bookingRows, users] = await Promise.all([
  db.select().from(BookingsTable),
  db.select().from(User)
]);
const userMap = new Map(users.map((u) => [u.id, u]));
const now = new Date();

const upcoming = bookingRows
  .filter((b) => bookingEnd(b.startsAt, b.durationMin).getTime() > now.getTime())
  .sort((a, b) => a.startsAt.getTime() - b.startsAt.getTime());

const past = bookingRows
  .filter((b) => bookingEnd(b.startsAt, b.durationMin).getTime() <= now.getTime())
  .sort((a, b) => b.startsAt.getTime() - a.startsAt.getTime());
---

<Layout title={t("bookings")}>
  <AppHeader title={`${t("admin")} · ${t("bookings")}`} backHref="/" />
  <main class="mx-auto w-full max-w-lg px-3 py-4 pb-20 md:max-w-2xl lg:max-w-4xl lg:px-4">
    <div class="mb-4 flex gap-2">
      <a href="/admin/users" class="btn btn-ghost btn-sm">{t("users")}</a>
      <a href="/admin/bookings" class="btn btn-primary btn-sm">{t("bookings")}</a>
      <a href="/admin/timeline" class="btn btn-ghost btn-sm">{t("timeline")}</a>
    </div>

    <section class="mb-8">
      <h2 class="mb-3 text-base font-semibold">{t("upcomingBookings")}</h2>
      <ul class="flex flex-col gap-3">
        {
          upcoming.length === 0 && (
            <li class="rounded-xl border border-dashed border-base-300 bg-base-100 py-8 text-center text-base-content/60">
              {t("noUpcomingBookings")}
            </li>
          )
        }
        {
          upcoming.map((b) => {
            const u = userMap.get(b.userId);
            const end = effectiveEnd(b);
            const p = getZonedParts(b.startsAt);
            return (
              <li class="rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm">
                <p class="font-semibold">
                  {p.dateKey} · {formatTime(b.startsAt, locale)} – {formatTime(end, locale)}
                </p>
                <p class="text-sm text-base-content/60">
                  {u?.name || "—"} · {u?.email || b.userId} · {b.durationMin} min
                  {b.endedAt ? ` · ${t("endedEarly")}` : ""}
                </p>
                <form method="POST" action={actions.admin.deleteBooking} class="mt-3">
                  <input type="hidden" name="id" value={b.id} />
                  <button type="submit" class="btn btn-outline btn-error btn-xs">
                    {t("delete")}
                  </button>
                </form>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2 class="mb-3 text-base font-semibold">{t("pastBookings")}</h2>
      <ul class="flex flex-col gap-3">
        {
          past.length === 0 && (
            <li class="rounded-xl border border-dashed border-base-300 bg-base-100 py-8 text-center text-base-content/60">
              {t("noPastBookings")}
            </li>
          )
        }
        {
          past.map((b) => {
            const u = userMap.get(b.userId);
            const end = effectiveEnd(b);
            const p = getZonedParts(b.startsAt);
            return (
              <li class="rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm">
                <p class="font-semibold">
                  {p.dateKey} · {formatTime(b.startsAt, locale)} – {formatTime(end, locale)}
                </p>
                <p class="text-sm text-base-content/60">
                  {u?.name || "—"} · {u?.email || b.userId} · {b.durationMin} min
                  {b.endedAt ? ` · ${t("endedEarly")}` : ""}
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>
</Layout>
