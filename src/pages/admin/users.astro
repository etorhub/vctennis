---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import { formatApartment } from "@/lib/apartment";
import { db, Bookings, User, gt, eq, and } from "astro:db";

const { t, user } = Astro.locals;

const users = await db.select().from(User);
users.sort((a, b) => a.createdAt.getTime() - b.createdAt.getTime());
const now = new Date();

const bookingCounts = await Promise.all(
  users.map(async (u) => {
    const active = await db
      .select()
      .from(Bookings)
      .where(and(eq(Bookings.userId, u.id), gt(Bookings.startsAt, now)));
    return [u.id, active.length] as const;
  })
);
const countMap = new Map(bookingCounts);
---

<Layout title={t("users")}>
  <AppHeader title={`${t("admin")} · ${t("users")}`} backHref="/" />
  <main class="mx-auto w-full max-w-lg px-3 py-4 pb-20 md:max-w-2xl lg:max-w-4xl lg:px-4">
    <div class="mb-4 flex gap-2">
      <a href="/admin/users" class="btn btn-primary btn-sm">{t("users")}</a>
      <a href="/admin/bookings" class="btn btn-ghost btn-sm">{t("bookings")}</a>
    </div>

    <ul class="flex flex-col gap-3">
      {
        users.map((u) => (
          <li class="rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="truncate font-semibold">{u.name || "—"}</p>
                <p class="truncate text-sm text-base-content/60">{u.email}</p>
                <p class="mt-1 text-xs text-base-content/50">{formatApartment(u, t)}</p>
                <p class="mt-1 text-xs text-base-content/50">
                  {t("role")}: {u.role === "admin" ? t("admin") : t("member")} · {t("signupIp")}: {u.signupIp || "—"} ·{" "}
                  {t("activeBookings")}: {countMap.get(u.id) ?? 0}
                  {u.disabled ? ` · ${t("accountDisabled")}` : ""}
                </p>
              </div>
            </div>

            {u.id !== user?.id && (
              <div class="mt-3 flex flex-wrap gap-2">
                <form method="POST" action={actions.admin.setRole}>
                  <input type="hidden" name="userId" value={u.id} />
                  <input type="hidden" name="role" value={u.role === "admin" ? "member" : "admin"} />
                  <button type="submit" class="btn btn-outline btn-xs">
                    {u.role === "admin" ? t("makeMember") : t("makeAdmin")}
                  </button>
                </form>
                <form method="POST" action={actions.admin.setDisabled}>
                  <input type="hidden" name="userId" value={u.id} />
                  <input type="hidden" name="disabled" value={u.disabled ? "false" : "true"} />
                  <button type="submit" class="btn btn-outline btn-xs">
                    {u.disabled ? t("enable") : t("disable")}
                  </button>
                </form>
                <form
                  method="POST"
                  action={actions.admin.deleteUser}
                  onsubmit={`return confirm(${JSON.stringify(t("confirmDeleteUser"))})`}
                >
                  <input type="hidden" name="userId" value={u.id} />
                  <button type="submit" class="btn btn-outline btn-error btn-xs">
                    {t("delete")}
                  </button>
                </form>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
