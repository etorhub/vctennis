---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import BookingSheet from "@/components/BookingSheet.astro";
import { db, Bookings, eq } from "astro:db";
import { bookingEnd, formatFullDate, formatTime } from "@/lib/time";
import type { MessageKey } from "@/lib/i18n";

const { t, locale, user } = Astro.locals;

if (!user) return Astro.redirect("/sign-in");

const updateResult = Astro.getActionResult(actions.bookings.update);
const deleteResult = Astro.getActionResult(actions.bookings.delete);

let toastMessage = "";
let toastErrorMessage = "";

if (updateResult?.data?.success) toastMessage = t("bookingUpdated");
if (deleteResult?.data?.success) toastMessage = t("bookingDeleted");

const err = updateResult?.error?.message || deleteResult?.error?.message;
if (err) {
  const key = err as MessageKey;
  toastErrorMessage = t(key) !== String(key) ? t(key) : t("errorGeneric");
}

const now = new Date();
const rows = await db.select().from(Bookings).where(eq(Bookings.userId, user.id));

const upcoming = rows
  .filter((b) => bookingEnd(b.startsAt, b.durationMin).getTime() > now.getTime())
  .sort((a, b) => a.startsAt.getTime() - b.startsAt.getTime());

const past = rows
  .filter((b) => bookingEnd(b.startsAt, b.durationMin).getTime() <= now.getTime())
  .sort((a, b) => b.startsAt.getTime() - a.startsAt.getTime());

function durationLabel(durationMin: number) {
  return durationMin === 30 ? t("minutes30") : t("minutes60");
}
---

<Layout title={t("myBookings")}>
  <AppHeader title={t("myBookings")} backHref="/settings" />
  {
    toastMessage && (
      <div x-init={`toastMessage = ${JSON.stringify(toastMessage)}`} class="sr-only" />
    )
  }
  {
    toastErrorMessage && (
      <div x-init={`toastErrorMessage = ${JSON.stringify(toastErrorMessage)}`} class="sr-only" />
    )
  }

  <main class="mx-auto w-full max-w-lg px-3 py-4 pb-24 md:max-w-2xl lg:px-4">
    <section class="mb-8">
      <h2 class="mb-3 text-base font-semibold">{t("upcomingBookings")}</h2>
      <ul class="flex flex-col gap-3">
        {
          upcoming.length === 0 && (
            <li class="rounded-xl border border-dashed border-base-300 bg-base-100 py-8 text-center text-base-content/60">
              {t("noUpcomingBookings")}
            </li>
          )
        }
        {
          upcoming.map((b) => {
            const end = bookingEnd(b.startsAt, b.durationMin);
            return (
              <li class="rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm">
                <p class="font-semibold">{formatFullDate(b.startsAt, locale)}</p>
                <p class="mt-0.5 text-sm text-base-content/60">
                  {formatTime(b.startsAt, locale)} – {formatTime(end, locale)} ·{" "}
                  {durationLabel(b.durationMin)}
                </p>
                <button
                  type="button"
                  class="btn btn-primary btn-sm mt-3"
                  data-id={b.id}
                  data-starts={b.startsAt.toISOString()}
                  data-duration={b.durationMin}
                  onclick="window.dispatchEvent(new CustomEvent('open-booking-sheet', { detail: { mode: 'edit', id: this.dataset.id, startsAt: this.dataset.starts, durationMin: Number(this.dataset.duration) } }))"
                >
                  {t("editBooking")}
                </button>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2 class="mb-3 text-base font-semibold">{t("pastBookings")}</h2>
      <ul class="flex flex-col gap-3">
        {
          past.length === 0 && (
            <li class="rounded-xl border border-dashed border-base-300 bg-base-100 py-8 text-center text-base-content/60">
              {t("noPastBookings")}
            </li>
          )
        }
        {
          past.map((b) => {
            const end = bookingEnd(b.startsAt, b.durationMin);
            return (
              <li class="rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm">
                <p class="font-semibold">{formatFullDate(b.startsAt, locale)}</p>
                <p class="mt-0.5 text-sm text-base-content/60">
                  {formatTime(b.startsAt, locale)} – {formatTime(end, locale)} ·{" "}
                  {durationLabel(b.durationMin)}
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>

  <BookingSheet />
</Layout>
