---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import BookingSheet from "@/components/BookingSheet.astro";
import { db, Bookings, User, gte, lte, and } from "astro:db";
import { OPEN_HOUR, CLOSE_HOUR } from "@/lib/config";
import {
  agendaDays,
  bookingEnd,
  formatDayHeader,
  formatTime,
  getZonedParts,
  hourLabels,
  zonedDate
} from "@/lib/time";
import type { MessageKey } from "@/lib/i18n";

const { t, locale, user } = Astro.locals;

const createResult = Astro.getActionResult(actions.bookings.create);
const updateResult = Astro.getActionResult(actions.bookings.update);
const deleteResult = Astro.getActionResult(actions.bookings.delete);

let toastMessage = "";
let toastErrorMessage = "";

if (createResult?.data?.success) toastMessage = t("bookingCreated");
if (updateResult?.data?.success) toastMessage = t("bookingUpdated");
if (deleteResult?.data?.success) toastMessage = t("bookingDeleted");

const err =
  createResult?.error?.message || updateResult?.error?.message || deleteResult?.error?.message;
if (err) {
  const key = err as MessageKey;
  toastErrorMessage = t(key) !== String(key) ? t(key) : t("errorGeneric");
}

const days = agendaDays();
const rangeStart = days[0];
const last = days[days.length - 1];
const lp = getZonedParts(last);
const rangeEnd = zonedDate(lp.year, lp.month, lp.day, CLOSE_HOUR, 0);

const bookingsRaw = await db
  .select()
  .from(Bookings)
  .where(and(gte(Bookings.startsAt, rangeStart), lte(Bookings.startsAt, rangeEnd)));

const users = await db.select().from(User);
const userMap = new Map(users.map((u) => [u.id, u]));

const hours = hourLabels();
const hourHeight = 64;

type ViewBooking = {
  id: string;
  startsAtIso: string;
  durationMin: number;
  label: string;
  mine: boolean;
  canEdit: boolean;
  top: number;
  height: number;
  timeLabel: string;
  dateKey: string;
};

const viewBookings: ViewBooking[] = bookingsRaw.map((b) => {
  const u = userMap.get(b.userId);
  const parts = getZonedParts(b.startsAt);
  const minutesFromOpen = (parts.hour - OPEN_HOUR) * 60 + parts.minute;
  const top = (minutesFromOpen / 60) * hourHeight;
  const height = Math.max((b.durationMin / 60) * hourHeight - 2, 28);
  const end = bookingEnd(b.startsAt, b.durationMin);
  const mine = !!user && user.id === b.userId;
  const canEdit = mine || user?.role === "admin";
  const show = u?.showName !== false;
  const name = show ? u?.name || t("reserved") : t("reserved");
  return {
    id: b.id,
    startsAtIso: b.startsAt.toISOString(),
    durationMin: b.durationMin,
    label: mine ? `${name} (${t("you")})` : name,
    mine,
    canEdit,
    top,
    height,
    timeLabel: `${formatTime(b.startsAt, locale)} – ${formatTime(end, locale)}`,
    dateKey: parts.dateKey
  };
});
---

<Layout title={t("siteName")}>
  <AppHeader />

  {toastMessage && <div x-init={`toastMessage = ${JSON.stringify(toastMessage)}`} class="sr-only" />}
  {
    toastErrorMessage && (
      <div x-init={`toastErrorMessage = ${JSON.stringify(toastErrorMessage)}`} class="sr-only" />
    )
  }

  <main class="mx-auto max-w-lg pb-28">
    {
      days.map((day) => {
        const dayParts = getZonedParts(day);
        const dayBookings = viewBookings.filter((b) => b.dateKey === dayParts.dateKey);
        return (
          <section class="agenda-day border-b border-slate-100" id={`day-${dayParts.dateKey}`}>
            <div class="sticky top-[57px] z-10 bg-slate-50/95 px-4 py-2 backdrop-blur">
              <h2 class="text-sm font-semibold capitalize text-slate-700">
                {formatDayHeader(day, locale, { today: t("today"), tomorrow: t("tomorrow") })}
              </h2>
            </div>
            <div class="relative px-2 pb-4">
              <div class="agenda-grid">
                {hours.map((h) => (
                  <div class="agenda-hour-line relative">
                    <span class="absolute left-2 top-0 -translate-y-1/2 text-xs text-slate-400">
                      {String(h).padStart(2, "0")}:00
                    </span>
                  </div>
                ))}
                {dayBookings.map((b) =>
                  b.canEdit ? (
                    <button
                      type="button"
                      class:list={["agenda-booking text-left", { mine: b.mine }]}
                      style={`top: ${b.top}px; height: ${b.height}px;`}
                      data-id={b.id}
                      data-starts={b.startsAtIso}
                      data-duration={b.durationMin}
                      onclick="window.dispatchEvent(new CustomEvent('open-booking-sheet', { detail: { mode: 'edit', id: this.dataset.id, startsAt: this.dataset.starts, durationMin: Number(this.dataset.duration) } }))"
                    >
                      <div class="text-xs font-semibold leading-tight">{b.timeLabel}</div>
                      <div class="truncate text-xs opacity-95">{b.label}</div>
                    </button>
                  ) : (
                    <div
                      class="agenda-booking"
                      style={`top: ${b.top}px; height: ${b.height}px;`}
                    >
                      <div class="text-xs font-semibold leading-tight">{b.timeLabel}</div>
                      <div class="truncate text-xs opacity-95">{b.label}</div>
                    </div>
                  )
                )}
              </div>
              {dayBookings.length === 0 && (
                <p class="pointer-events-none absolute inset-x-16 top-8 text-center text-sm text-slate-400">
                  {t("noBookings")}
                </p>
              )}
            </div>
          </section>
        );
      })
    }
  </main>

  <button
    type="button"
    class="fab"
    aria-label={user ? t("book") : t("signInToBook")}
    onclick="window.dispatchEvent(new CustomEvent('open-booking-sheet', { detail: { mode: 'create' } }))"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      ><path d="M12 5v14M5 12h14"></path></svg
    >
  </button>

  <BookingSheet />
</Layout>
