---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import BookingSheet from "@/components/BookingSheet.astro";
import { db, Bookings, User, gte, lte, and } from "astro:db";
import { OPEN_HOUR, CLOSE_HOUR, SLOT_MINUTES } from "@/lib/config";
import {
  agendaDays,
  bookingEnd,
  formatDayHeader,
  formatFullDate,
  formatTime,
  getZonedParts,
  hourLabels,
  isFuture,
  isWithinOpenHours,
  rangesOverlap,
  zonedDate
} from "@/lib/time";
import type { MessageKey } from "@/lib/i18n";

const { t, locale, user } = Astro.locals;

const createResult = Astro.getActionResult(actions.bookings.create);
const updateResult = Astro.getActionResult(actions.bookings.update);
const deleteResult = Astro.getActionResult(actions.bookings.delete);

let toastMessage = "";
let toastErrorMessage = "";

if (createResult?.data?.success) toastMessage = t("bookingCreated");
if (updateResult?.data?.success) toastMessage = t("bookingUpdated");
if (deleteResult?.data?.success) toastMessage = t("bookingDeleted");

const err =
  createResult?.error?.message || updateResult?.error?.message || deleteResult?.error?.message;
if (err) {
  const key = err as MessageKey;
  toastErrorMessage = t(key) !== String(key) ? t(key) : t("errorGeneric");
}

const days = agendaDays();
const rangeStart = days[0];
const last = days[days.length - 1];
const lp = getZonedParts(last);
const rangeEnd = zonedDate(lp.year, lp.month, lp.day, CLOSE_HOUR, 0);

const [bookingsRaw, users] = await Promise.all([
  db
    .select()
    .from(Bookings)
    .where(and(gte(Bookings.startsAt, rangeStart), lte(Bookings.startsAt, rangeEnd))),
  db.select().from(User)
]);
const userMap = new Map(users.map((u) => [u.id, u]));

const hours = hourLabels();
const hourHeight = 64;
const now = new Date();
const nowParts = getZonedParts(now);
const todayKey = nowParts.dateKey;

type ViewBooking = {
  id: string;
  startsAtIso: string;
  durationMin: number;
  label: string;
  dayLabel: string;
  mine: boolean;
  canManage: boolean;
  top: number;
  height: number;
  timeLabel: string;
  dateKey: string;
  endMinutesFromOpen: number;
};

const viewBookings: ViewBooking[] = bookingsRaw.map((b) => {
  const u = userMap.get(b.userId);
  const parts = getZonedParts(b.startsAt);
  const minutesFromOpen = (parts.hour - OPEN_HOUR) * 60 + parts.minute;
  const top = (minutesFromOpen / 60) * hourHeight;
  const height = Math.max((b.durationMin / 60) * hourHeight - 2, 28);
  const end = bookingEnd(b.startsAt, b.durationMin);
  const mine = !!user && user.id === b.userId;
  const canManage = mine || user?.role === "admin";
  const show = u?.showName !== false;
  const name = show ? u?.name || t("reserved") : t("reserved");
  return {
    id: b.id,
    startsAtIso: b.startsAt.toISOString(),
    durationMin: b.durationMin,
    label: mine ? `${name} (${t("you")})` : name,
    dayLabel: formatFullDate(b.startsAt, locale),
    mine,
    canManage,
    top,
    height,
    timeLabel: `${formatTime(b.startsAt, locale)} – ${formatTime(end, locale)}`,
    dateKey: parts.dateKey,
    endMinutesFromOpen: minutesFromOpen + b.durationMin
  };
});

function hiddenPastHoursForDay(dateKey: string): number {
  if (dateKey !== todayKey) return 0;
  if (nowParts.hour < OPEN_HOUR) return 0;
  if (nowParts.hour >= CLOSE_HOUR) return CLOSE_HOUR - OPEN_HOUR;
  return nowParts.hour - OPEN_HOUR;
}

type ViewSlot = {
  startsAtIso: string;
  durationMin: 30 | 60;
  top: number;
  height: number;
  timeLabel: string;
  minutesFromOpen: number;
};

/** Open, aligned, future, unoccupied slots a member can tap to prefill the create sheet. */
function openSlotsForDay(dayParts: ReturnType<typeof getZonedParts>, dayBookings: ViewBooking[]): ViewSlot[] {
  const slots: ViewSlot[] = [];
  for (let hour = OPEN_HOUR; hour < CLOSE_HOUR; hour++) {
    for (let minute = 0; minute < 60; minute += SLOT_MINUTES) {
      const slotStart = zonedDate(dayParts.year, dayParts.month, dayParts.day, hour, minute);
      if (!isWithinOpenHours(slotStart, SLOT_MINUTES)) continue;
      if (!isFuture(slotStart, now)) continue;
      const occupied = dayBookings.some((b) =>
        rangesOverlap(slotStart, SLOT_MINUTES, new Date(b.startsAtIso), b.durationMin)
      );
      if (occupied) continue;
      const canFitHour =
        isWithinOpenHours(slotStart, 60) &&
        !dayBookings.some((b) => rangesOverlap(slotStart, 60, new Date(b.startsAtIso), b.durationMin));
      const minutesFromOpen = (hour - OPEN_HOUR) * 60 + minute;
      slots.push({
        startsAtIso: slotStart.toISOString(),
        durationMin: canFitHour ? 60 : 30,
        top: (minutesFromOpen / 60) * hourHeight,
        height: (SLOT_MINUTES / 60) * hourHeight,
        timeLabel: formatTime(slotStart, locale),
        minutesFromOpen
      });
    }
  }
  return slots;
}

const dayViews = days.map((day, index) => {
  const dayParts = getZonedParts(day);
  const hiddenPastHours = hiddenPastHoursForDay(dayParts.dateKey);
  const title = formatDayHeader(day, locale, { today: t("today"), tomorrow: t("tomorrow") });
  const dayBookings = viewBookings.filter((b) => b.dateKey === dayParts.dateKey);
  return {
    index,
    dateKey: dayParts.dateKey,
    title,
    hiddenPastHours,
    bookings: dayBookings,
    slots: openSlotsForDay(dayParts, dayBookings)
  };
});
---

<Layout title={t("siteName")}>
  <AppHeader />

  {toastMessage && <div x-init={`toastMessage = ${JSON.stringify(toastMessage)}`} class="sr-only" />}
  {
    toastErrorMessage && (
      <div x-init={`toastErrorMessage = ${JSON.stringify(toastErrorMessage)}`} class="sr-only" />
    )
  }

  <main
    class="pb-28 lg:min-h-[calc(100dvh-3.5rem)] lg:bg-base-200"
    x-data={`{ dayIndex: 0, dayCount: ${dayViews.length} }`}
  >
    <div class="mx-auto w-full max-w-lg md:max-w-2xl lg:max-w-7xl">
      <div
        class="sticky top-[61px] z-10 flex items-center gap-1 border-b border-base-300 bg-base-200/95 px-2 py-2 backdrop-blur lg:hidden"
      >
      <button
        type="button"
        class="btn btn-ghost btn-sm btn-circle"
        aria-label={t("previousDay")}
        :disabled="dayIndex === 0"
        @click="dayIndex = Math.max(0, dayIndex - 1)"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="m15 18-6-6 6-6"></path></svg
        >
      </button>
      <div class="min-w-0 flex-1 text-center">
        {
          dayViews.map((day) => (
            <h2
              class="text-sm font-semibold capitalize text-base-content"
              x-show={`dayIndex === ${day.index}`}
              x-cloak={day.index !== 0 ? true : undefined}
            >
              {day.title}
            </h2>
          ))
        }
      </div>
      <button
        type="button"
        class="btn btn-ghost btn-sm btn-circle"
        aria-label={t("nextDay")}
        :disabled="dayIndex === dayCount - 1"
        @click="dayIndex = Math.min(dayCount - 1, dayIndex + 1)"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="m9 18 6-6-6-6"></path></svg
        >
      </button>
    </div>

    <div
      class="agenda-days lg:grid lg:gap-3 lg:px-3 lg:pb-4 lg:pt-3"
      style={`--day-cols: ${dayViews.length}`}
    >
    {
      dayViews.map((day) => {
        const offsetPx = day.hiddenPastHours * hourHeight;
        const fullHours = hours.length;
        const collapsedHours = fullHours - day.hiddenPastHours;
        const startMinutesWhenCollapsed = day.hiddenPastHours * 60;
        const initialHours = day.hiddenPastHours > 0 ? collapsedHours : fullHours;

        return (
          <section
            class="agenda-day lg:rounded-xl lg:border lg:border-base-300 lg:bg-base-100"
            id={`day-${day.dateKey}`}
            x-show={`dayIndex === ${day.index}`}
            x-cloak={day.index !== 0 ? true : undefined}
          >
            <div class="sticky top-[61px] z-10 hidden border-b border-base-300 bg-base-200/95 px-3 py-2.5 backdrop-blur lg:block lg:rounded-t-xl">
              <h2 class="text-center text-sm font-semibold capitalize text-base-content">
                {day.title}
              </h2>
            </div>
            <div
              class="relative px-2 pb-4 pt-2 md:px-3 lg:overflow-hidden lg:rounded-b-xl"
              x-data={`{ showPastHours: false, hiddenPastHours: ${day.hiddenPastHours}, hourHeight: ${hourHeight}, fullHours: ${fullHours}, collapsedHours: ${collapsedHours} }`}
            >
              {day.hiddenPastHours > 0 && (
                <div class="mb-2 px-2" x-show="!showPastHours">
                  <button
                    type="button"
                    class="btn btn-ghost btn-xs w-full text-base-content/60"
                    @click="showPastHours = true"
                  >
                    {t("showEarlierHours")}
                  </button>
                </div>
              )}
              <div
                class="agenda-grid"
                style={`--agenda-hours: ${initialHours}`}
                x-bind:style={`{ '--agenda-hours': showPastHours || hiddenPastHours === 0 ? fullHours : collapsedHours }`}
              >
                {hours.map((h, hourIndex) => {
                  const visibleWhenCollapsed = hourIndex >= day.hiddenPastHours;
                  return (
                    <div
                      class="agenda-hour-line relative"
                      x-show={
                        day.hiddenPastHours > 0
                          ? `showPastHours || ${hourIndex} >= hiddenPastHours`
                          : undefined
                      }
                      style={
                        day.hiddenPastHours > 0 && !visibleWhenCollapsed
                          ? "display: none"
                          : undefined
                      }
                    >
                      <span class="absolute left-2 top-1 text-xs text-base-content/50 lg:left-1 lg:text-[11px]">
                        {String(h).padStart(2, "0")}:00
                      </span>
                    </div>
                  );
                })}
                {day.slots.map((slot) => {
                  const visibleWhenCollapsed = slot.minutesFromOpen + SLOT_MINUTES > startMinutesWhenCollapsed;
                  const collapsedTop = slot.top - offsetPx;
                  const initialTop = day.hiddenPastHours > 0 ? collapsedTop : slot.top;
                  const initialDisplay =
                    day.hiddenPastHours > 0 && !visibleWhenCollapsed ? "none" : undefined;
                  const styleParts = [`top: ${initialTop}px`, `height: ${slot.height}px`];
                  if (initialDisplay) styleParts.push(`display: ${initialDisplay}`);
                  const slotStyle = styleParts.join("; ");
                  const slotBind =
                    day.hiddenPastHours > 0
                      ? `{
                          display: (showPastHours || ${visibleWhenCollapsed}) ? null : 'none',
                          top: (showPastHours ? ${slot.top} : ${collapsedTop}) + 'px',
                          height: '${slot.height}px'
                        }`
                      : undefined;

                  return (
                    <button
                      type="button"
                      class="agenda-slot"
                      style={slotStyle}
                      x-bind:style={slotBind}
                      aria-label={t("bookAt", { time: slot.timeLabel })}
                      data-starts={slot.startsAtIso}
                      data-duration={slot.durationMin}
                      onclick="window.dispatchEvent(new CustomEvent('open-booking-sheet', { detail: { mode: 'create', startsAt: this.dataset.starts, durationMin: Number(this.dataset.duration) } }))"
                    />
                  );
                })}
                {day.bookings.map((b) => {
                  const visibleWhenCollapsed = b.endMinutesFromOpen > startMinutesWhenCollapsed;
                  const collapsedTop = b.top - offsetPx;
                  const initialTop = day.hiddenPastHours > 0 ? collapsedTop : b.top;
                  const initialDisplay =
                    day.hiddenPastHours > 0 && !visibleWhenCollapsed ? "none" : undefined;
                  const styleParts = [`top: ${initialTop}px`, `height: ${b.height}px`];
                  if (initialDisplay) styleParts.push(`display: ${initialDisplay}`);
                  const bookingStyle = styleParts.join("; ");
                  const bookingBind =
                    day.hiddenPastHours > 0
                      ? `{
                          display: (showPastHours || ${visibleWhenCollapsed}) ? null : 'none',
                          top: (showPastHours ? ${b.top} : ${collapsedTop}) + 'px',
                          height: '${b.height}px'
                        }`
                      : undefined;

                  return (
                    <button
                      type="button"
                      class:list={["agenda-booking text-left", { mine: b.mine }]}
                      style={bookingStyle}
                      x-bind:style={bookingBind}
                      data-id={b.id}
                      data-starts={b.startsAtIso}
                      data-duration={b.durationMin}
                      data-label={b.label}
                      data-time={b.timeLabel}
                      data-day={b.dayLabel}
                      data-manage={b.canManage ? "1" : "0"}
                      onclick="window.dispatchEvent(new CustomEvent('open-booking-sheet', { detail: { mode: 'view', id: this.dataset.id, startsAt: this.dataset.starts, durationMin: Number(this.dataset.duration), label: this.dataset.label, timeLabel: this.dataset.time, dayLabel: this.dataset.day, canManage: this.dataset.manage === '1' } }))"
                    >
                      <div class="text-xs font-semibold leading-tight">{b.timeLabel}</div>
                      <div class="truncate text-xs opacity-95">{b.label}</div>
                    </button>
                  );
                })}
              </div>
              {day.bookings.length === 0 && (
                <p class="pointer-events-none absolute inset-x-16 top-10 text-center text-sm text-base-content/50 lg:inset-x-10">
                  {t("noBookings")}
                </p>
              )}
            </div>
          </section>
        );
      })
    }
    </div>
    </div>
  </main>

  <button
    type="button"
    class="fab"
    aria-label={user ? t("book") : t("signInToBook")}
    onclick="window.dispatchEvent(new CustomEvent('open-booking-sheet', { detail: { mode: 'create' } }))"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      ><path d="M12 5v14M5 12h14"></path></svg
    >
  </button>

  <BookingSheet />
</Layout>
