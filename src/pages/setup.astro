---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import { db, eq, User } from "astro:db";

const { t, user } = Astro.locals;

// Check action result before the "admin exists" gate: the becomeAdmin
// handler creates an admin, so checking the DB first would block the success redirect.
const result = Astro.getActionResult(actions.auth.becomeAdmin);
if (result?.data?.success) {
  return Astro.redirect("/admin/users");
}

// Already admin (e.g. after a prior successful setup) → go to admin UI.
if (user?.role === "admin") {
  return Astro.redirect("/admin/users");
}

const admins = await db.select().from(User).where(eq(User.role, "admin")).limit(1);
if (admins.length > 0) {
  return Astro.redirect("/");
}
---

<Layout title={t("setupTitle")}>
  <AppHeader title={t("setupTitle")} backHref="/" />
  <main class="mx-auto max-w-sm px-4 py-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">{t("setupTitle")}</h1>
      <p class="mb-6 text-sm text-slate-600">{t("setupHelp")}</p>
      {
        result?.error && (
          <p class="mb-4 text-sm text-error">{result.error.message}</p>
        )
      }
      <p class="mb-4 text-sm">
        {user?.email}
      </p>
      <form method="POST" action={actions.auth.becomeAdmin}>
        <button type="submit" class="btn btn-primary w-full">{t("becomeAdmin")}</button>
      </form>
    </div>
  </main>
</Layout>
