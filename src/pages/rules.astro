---
import Icon from "astro-iconify";
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import { actions } from "astro:actions";
import type { MessageKey } from "@/lib/i18n";
import { ALLOWED_DURATIONS, BOOK_AHEAD_DAYS, CLOSE_HOUR, MAX_ACTIVE_BOOKINGS, OPEN_HOUR } from "@/lib/config";

const { t, user } = Astro.locals;
const aheadDays = Math.max(BOOK_AHEAD_DAYS - 1, 0);
const durations = ALLOWED_DURATIONS.join(" / ");
const maxBookings =
  MAX_ACTIVE_BOOKINGS === 1 ? t("rulesBookingMaxOne") : t("rulesBookingMaxMany", { max: MAX_ACTIVE_BOOKINGS });

const etiquettePictograms = [
  { icon: "footprints", label: t("rulesEtiquetteShoes") },
  { icon: "volleyball", label: t("rulesEtiquetteNoBalls") },
  { icon: "bike", label: t("rulesEtiquetteNoBikes") },
  { icon: "dog", label: t("rulesEtiquetteNoPets") }
];

const contactResult = Astro.getActionResult(actions.contact.send);
const contactSent = !!contactResult?.data?.success;
const contactErrKey = contactResult?.error?.message as MessageKey | undefined;
const contactError = contactErrKey
  ? t(contactErrKey) !== String(contactErrKey)
    ? t(contactErrKey)
    : t("errorGeneric")
  : "";
---

<Layout title={t("rules")}>
  <AppHeader title={t("rules")} backHref="/" />
  <main class="mx-auto max-w-lg px-4 py-6">
    <div class="flex flex-col gap-6 rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm">
      <section class="flex flex-col gap-2">
        <h2 class="text-base font-semibold text-base-content">{t("rulesHoursTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">
          {t("rulesHoursBody", { open: OPEN_HOUR, close: CLOSE_HOUR })}
        </p>
      </section>

      <section class="flex flex-col gap-2 border-t border-base-300 pt-6">
        <h2 class="text-base font-semibold text-base-content">{t("rulesBookingTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">
          {
            t("rulesBookingBody", {
              days: BOOK_AHEAD_DAYS,
              ahead: aheadDays,
              maxBookings,
              durations
            })
          }
        </p>
      </section>

      <section class="flex flex-col gap-3 border-t border-base-300 pt-6">
        <h2 class="text-base font-semibold text-base-content">{t("rulesEtiquetteTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">{t("rulesEtiquetteIntro")}</p>
        <ul class="grid grid-cols-2 gap-3">
          {
            etiquettePictograms.map(({ icon, label }) => (
              <li class="flex items-center gap-3">
                <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-700 dark:bg-green-950 dark:text-green-300">
                  <Icon pack="lucide" name={icon} height={20} width={20} />
                  <span
                    aria-hidden="true"
                    class="absolute left-1/2 top-1/2 h-0.5 w-[130%] -translate-x-1/2 -translate-y-1/2 rotate-45 rounded-full bg-red-500"
                  />
                </span>
                <span class="text-sm leading-snug text-base-content/70">{label}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="flex flex-col gap-3 border-t border-base-300 pt-6">
        <h2 class="text-base font-semibold text-base-content">{t("rulesContactTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">{t("rulesContactIntro")}</p>

        {
          !user ? (
            <p class="text-sm text-base-content/70">
              {t("rulesContactSignInPrompt")}{" "}
              <a href="/sign-in" class="link link-primary">
                {t("signIn")}
              </a>
            </p>
          ) : (
            <div>
              {contactSent && (
                <p class="mb-3 text-sm font-medium text-primary">{t("rulesContactSuccess")}</p>
              )}

              <p class="mb-3 text-sm text-base-content/60">
                {t("rulesContactSendingAs", { name: user.name ?? "", email: user.email ?? "" })}
              </p>

              <form method="POST" action={actions.contact.send}>
                <fieldset class="w-full">
                  <legend class="sr-only">{t("rulesContactType")}</legend>
                  <div class="grid grid-cols-2 gap-2">
                    <label class="cursor-pointer">
                      <input type="radio" name="type" value="contact" class="peer sr-only" checked required />
                      <span class="flex items-center justify-center rounded-xl border-2 border-base-300 bg-base-200 px-2 py-2.5 text-sm font-medium peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primary">
                        {t("rulesContactTypeContact")}
                      </span>
                    </label>
                    <label class="cursor-pointer">
                      <input type="radio" name="type" value="incident" class="peer sr-only" required />
                      <span class="flex items-center justify-center rounded-xl border-2 border-base-300 bg-base-200 px-2 py-2.5 text-sm font-medium peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primary">
                        {t("rulesContactTypeIncident")}
                      </span>
                    </label>
                  </div>
                </fieldset>

                <label class="form-control mt-3 w-full" for="contact-subject">
                  <div class="label py-1">
                    <span class="label-text">{t("rulesContactSubject")}</span>
                  </div>
                  <input
                    id="contact-subject"
                    name="subject"
                    type="text"
                    class="input input-bordered w-full"
                    required
                    maxlength="120"
                    placeholder={t("rulesContactSubjectPlaceholder")}
                  />
                </label>

                <label class="form-control mt-3 w-full" for="contact-message">
                  <div class="label py-1">
                    <span class="label-text">{t("rulesContactMessage")}</span>
                  </div>
                  <textarea
                    id="contact-message"
                    name="message"
                    class="textarea textarea-bordered w-full"
                    rows="4"
                    required
                    maxlength="2000"
                    placeholder={t("rulesContactMessagePlaceholder")}
                  />
                </label>

                {contactError && (
                  <p class="mt-2 text-sm text-error" role="alert">
                    {contactError}
                  </p>
                )}

                <button type="submit" class="btn btn-primary mt-4 w-full">
                  {t("rulesContactSubmit")}
                </button>
              </form>
            </div>
          )
        }
      </section>
    </div>
  </main>
</Layout>
