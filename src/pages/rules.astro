---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import {
  ALLOWED_DURATIONS,
  BOOK_AHEAD_DAYS,
  CLOSE_HOUR,
  MAX_ACTIVE_BOOKINGS,
  MIN_CANCEL_CHANGE_MINUTES,
  OPEN_HOUR
} from "@/lib/config";

const { t } = Astro.locals;
const aheadDays = Math.max(BOOK_AHEAD_DAYS - 1, 0);
const durations = ALLOWED_DURATIONS.join(" / ");
---

<Layout title={t("rules")}>
  <AppHeader title={t("rules")} backHref="/" />
  <main class="mx-auto max-w-lg px-4 py-6">
    <div class="flex flex-col gap-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <section class="flex flex-col gap-2">
        <h2 class="text-base font-semibold text-slate-900">{t("rulesHoursTitle")}</h2>
        <p class="text-sm leading-relaxed text-slate-600">
          {t("rulesHoursBody", { open: OPEN_HOUR, close: CLOSE_HOUR })}
        </p>
      </section>

      <section class="flex flex-col gap-2 border-t border-slate-100 pt-6">
        <h2 class="text-base font-semibold text-slate-900">{t("rulesBookingTitle")}</h2>
        <p class="text-sm leading-relaxed text-slate-600">
          {
            t("rulesBookingBody", {
              days: BOOK_AHEAD_DAYS,
              ahead: aheadDays,
              max: MAX_ACTIVE_BOOKINGS,
              durations,
              cutoff: MIN_CANCEL_CHANGE_MINUTES
            })
          }
        </p>
      </section>

      <section class="flex flex-col gap-2 border-t border-slate-100 pt-6">
        <h2 class="text-base font-semibold text-slate-900">{t("rulesEtiquetteTitle")}</h2>
        <ul class="list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-slate-600">
          <li>{t("rulesEtiquetteShoes")}</li>
          <li>{t("rulesEtiquetteOnlyTennis")}</li>
        </ul>
      </section>

      <section class="flex flex-col gap-2 border-t border-slate-100 pt-6">
        <h2 class="text-base font-semibold text-slate-900">{t("rulesAccessTitle")}</h2>
        <p class="text-sm leading-relaxed text-slate-600">{t("rulesAccessBody")}</p>
      </section>
    </div>
  </main>
</Layout>
