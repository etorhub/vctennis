---
// Static, prerendered detection target for Netlify Forms: Netlify parses the
// built HTML for forms at deploy time and this route never runs per-request
// (unlike the rest of the site, which is SSR and invisible to that scan).
// The real form lives on /rules and submits via fetch to the same form-name;
// Netlify's edge intercepts the submission by name regardless of target path.
// Never linked from the UI — kept out of the index via robots noindex.
export const prerender = true;
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Netlify Forms</title>
  </head>
  <body>
    <form name="contacte-incidencies" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input name="bot-field" />
      <input name="name" />
      <input name="email" />
      <input name="type" />
      <input name="subject" />
      <textarea name="message"></textarea>
    </form>
  </body>
</html>
