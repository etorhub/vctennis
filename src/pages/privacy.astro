---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";

const { t } = Astro.locals;
---

<Layout title={t("privacy")}>
  <AppHeader title={t("privacy")} backHref="/" />
  <main class="mx-auto max-w-lg px-4 py-6">
    <div class="flex flex-col gap-6 rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm">
      <section class="flex flex-col gap-2">
        <h2 class="text-base font-semibold text-base-content">{t("privacyAccountTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">{t("privacyAccountBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-base-300 pt-6">
        <h2 class="text-base font-semibold text-base-content">{t("privacyApartmentTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">{t("privacyApartmentBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-base-300 pt-6">
        <h2 class="text-base font-semibold text-base-content">{t("privacySignupIpTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">{t("privacySignupIpBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-base-300 pt-6">
        <h2 class="text-base font-semibold text-base-content">{t("privacyBookingsTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">{t("privacyBookingsBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-base-300 pt-6">
        <h2 class="text-base font-semibold text-base-content">{t("privacyShowNameTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">{t("privacyShowNameBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-base-300 pt-6">
        <h2 class="text-base font-semibold text-base-content">{t("privacyDeletionTitle")}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">{t("privacyDeletionBody")}</p>
      </section>
    </div>
  </main>
</Layout>
