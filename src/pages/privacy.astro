---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";

const { t } = Astro.locals;
---

<Layout title={t("privacy")}>
  <AppHeader title={t("privacy")} backHref="/" />
  <main class="mx-auto max-w-lg px-4 py-6">
    <div class="flex flex-col gap-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <section class="flex flex-col gap-2">
        <h2 class="text-base font-semibold text-slate-900">{t("privacyAccountTitle")}</h2>
        <p class="text-sm leading-relaxed text-slate-600">{t("privacyAccountBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-slate-100 pt-6">
        <h2 class="text-base font-semibold text-slate-900">{t("privacySignupIpTitle")}</h2>
        <p class="text-sm leading-relaxed text-slate-600">{t("privacySignupIpBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-slate-100 pt-6">
        <h2 class="text-base font-semibold text-slate-900">{t("privacyBookingsTitle")}</h2>
        <p class="text-sm leading-relaxed text-slate-600">{t("privacyBookingsBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-slate-100 pt-6">
        <h2 class="text-base font-semibold text-slate-900">{t("privacyShowNameTitle")}</h2>
        <p class="text-sm leading-relaxed text-slate-600">{t("privacyShowNameBody")}</p>
      </section>

      <section class="flex flex-col gap-2 border-t border-slate-100 pt-6">
        <h2 class="text-base font-semibold text-slate-900">{t("privacyDeletionTitle")}</h2>
        <p class="text-sm leading-relaxed text-slate-600">{t("privacyDeletionBody")}</p>
      </section>
    </div>
  </main>
</Layout>
