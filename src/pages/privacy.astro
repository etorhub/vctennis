---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import PrivacyContent from "@/components/PrivacyContent.astro";

const { t, user } = Astro.locals;

if (!user) return Astro.redirect("/sign-in");
---

<Layout title={t("privacy")}>
  <AppHeader title={t("privacy")} backHref="/" />
  <main class="mx-auto w-full max-w-sm px-4 py-6">
    <PrivacyContent />
  </main>
</Layout>
