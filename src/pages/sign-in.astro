---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";

const { t, user } = Astro.locals;
if (user && !user.disabled) {
  return Astro.redirect("/");
}
---

<Layout title={t("signIn")}>
  <AppHeader title={t("signIn")} backHref="/" />
  <main class="mx-auto max-w-sm px-4 py-8">
    <div
      class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
      x-data={`{
        email: '',
        sent: false,
        loading: false,
        error: '',
        async submit() {
          this.loading = true;
          this.error = '';
          try {
            const res = await fetch('/api/auth/sign-in/magic-link', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: this.email,
                callbackURL: '/'
              })
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.message || ${JSON.stringify(t("errorGeneric"))});
            }
            this.sent = true;
          } catch (e) {
            this.error = e.message || ${JSON.stringify(t("errorGeneric"))};
          } finally {
            this.loading = false;
          }
        }
      }`}
    >
      <h1 class="mb-1 text-xl font-semibold">{t("signIn")}</h1>
      <p class="mb-6 text-sm text-slate-500">{t("tagline")}</p>

      <div x-show="!sent">
        <label class="form-control w-full">
          <div class="label py-1"><span class="label-text">{t("email")}</span></div>
          <input
            type="email"
            class="input input-bordered w-full"
            x-model="email"
            required
            autocomplete="email"
            placeholder="name@example.com"
            @keydown.enter.prevent="submit()"
          />
        </label>
        <p class="mt-2 text-sm text-error" x-show="error" x-text="error"></p>
        <button
          type="button"
          class="btn btn-primary mt-4 w-full"
          :disabled="loading || !email"
          @click="submit()"
        >
          <span x-show="!loading">{t("sendMagicLink")}</span>
          <span x-show="loading" x-cloak>{t("loading")}</span>
        </button>
      </div>

      <div x-show="sent" x-cloak class="text-center">
        <p class="text-lg font-medium text-primary">{t("checkInbox")}</p>
        <p class="mt-2 text-sm text-slate-600">{t("magicLinkSent")}</p>
        <a href="/" class="btn btn-ghost mt-6 w-full">{t("backToCalendar")}</a>
      </div>
    </div>
  </main>
</Layout>
