---
import Icon from "astro-iconify";

interface Props {
  title?: string;
  backHref?: string;
}

const { t, user } = Astro.locals;
const { title = t("siteName"), backHref } = Astro.props;
---

<header
  class="sticky top-0 z-20 border-b border-base-300 bg-base-100/95 backdrop-blur supports-[backdrop-filter]:bg-base-100/80"
>
  <div class="mx-auto flex w-full max-w-lg items-center gap-2 px-3 py-3 md:max-w-2xl lg:max-w-7xl lg:px-4">
    {
      backHref ? (
        <a href={backHref} class="btn btn-ghost btn-sm btn-circle" aria-label={t("backToCalendar")}>
          <Icon pack="lucide" name="arrow-left" height={20} width={20} />
        </a>
      ) : (
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary">
          <Icon pack="lucide" name="calendar-days" height={20} width={20} />
        </div>
      )
    }
    <div class="min-w-0 flex-1">
      <h1 class="truncate text-base font-semibold leading-tight">{title}</h1>
    </div>
    <nav class="flex items-center gap-1">
      <a href="/rules" class="btn btn-ghost btn-sm" title={t("rules")} aria-label={t("rules")}>
        <Icon pack="lucide" name="circle-help" height={18} width={18} />
      </a>
      {
        user?.role === "admin" && (
          <a href="/admin/users" class="btn btn-ghost btn-sm" title={t("admin")}>
            <Icon pack="lucide" name="shield" height={18} width={18} />
          </a>
        )
      }
      {
        user ? (
          <div
            class="dropdown dropdown-end"
            x-data="{ open: false }"
            x-bind:class="{ 'dropdown-open': open }"
            @keydown.escape.window="open = false"
          >
            <button
              type="button"
              class="btn btn-ghost btn-sm"
              title={t("profile")}
              aria-label={t("profile")}
              aria-haspopup="menu"
              x-bind:aria-expanded="open"
              @click="open = !open"
            >
              <Icon pack="lucide" name="user" height={18} width={18} />
            </button>
            <ul
              x-show="open"
              x-cloak
              @click.outside="open = false"
              class="menu dropdown-content z-30 mt-1 w-52 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
              role="menu"
            >
              <li role="none">
                <a href="/my-bookings" role="menuitem" @click="open = false">{t("myBookings")}</a>
              </li>
              <li role="none">
                <a href="/profile" role="menuitem" @click="open = false">{t("profile")}</a>
              </li>
              <li role="none">
                <a href="/privacy" role="menuitem" @click="open = false">{t("privacy")}</a>
              </li>
              <li class="mt-1 border-t border-base-300 pt-1" role="separator"></li>
              <li role="none">
                <form method="POST" action="/sign-out" class="contents">
                  <button type="submit" role="menuitem">{t("signOut")}</button>
                </form>
              </li>
            </ul>
          </div>
        ) : (
          <a href="/sign-in" class="btn btn-primary btn-sm">
            {t("signIn")}
          </a>
        )
      }
    </nav>
  </div>
</header>
