---
import { actions } from "astro:actions";
import { OPEN_HOUR, CLOSE_HOUR } from "@/lib/config";
import { agendaDays, formatTime, slotOptionsForDay } from "@/lib/time";

const { t, locale, user } = Astro.locals;
const days = agendaDays();
const slotsByDay = days.map((d) => ({
  dateKey: d.toISOString(),
  label: new Intl.DateTimeFormat(locale === "ca" ? "ca-ES" : "en-GB", {
    weekday: "short",
    day: "numeric",
    month: "short",
    timeZone: "Europe/Madrid"
  }).format(d),
  slots: slotOptionsForDay(d).map((s) => ({
    value: s.toISOString(),
    label: formatTime(s, locale)
  }))
}));

const createAction = actions.bookings.create;
const updateAction = actions.bookings.update;
const deleteAction = actions.bookings.delete;
---

<div
  id="booking-sheet"
  x-data={`{
    open: false,
    mode: 'create',
    bookingId: '',
    startsAt: ${JSON.stringify(slotsByDay[0]?.slots[0]?.value || "")},
    durationMin: 60,
    slotsByDay: ${JSON.stringify(slotsByDay)},
    signedIn: ${JSON.stringify(!!user)},
    labels: {
      edit: ${JSON.stringify(t("editBooking"))},
      create: ${JSON.stringify(t("bookCourt"))}
    },
    init() {
      const onOpenBookingSheet = (e) => {
        const d = e.detail || {};
        if (!this.signedIn) {
          window.location.href = '/sign-in';
          return;
        }
        this.mode = d.mode || 'create';
        this.bookingId = d.id || '';
        this.startsAt = d.startsAt || (this.slotsByDay[0]?.slots[0]?.value || '');
        this.durationMin = d.durationMin || 60;
        this.open = true;
        document.body.style.overflow = 'hidden';
      };
      window.addEventListener('open-booking-sheet', onOpenBookingSheet);
      Alpine.onElRemoved(this.$el, () => window.removeEventListener('open-booking-sheet', onOpenBookingSheet));
    },
    close() {
      this.open = false;
      document.body.style.overflow = '';
    }
  }`}
  x-cloak
>
  <div class="sheet-backdrop" x-show="open" x-transition.opacity @click="close()"></div>

  <div
    class="bottom-sheet p-4"
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="translate-y-full"
    x-transition:enter-end="translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="translate-y-0"
    x-transition:leave-end="translate-y-full"
    @keydown.escape.window="open && close()"
  >
    <div class="mx-auto mb-3 h-1.5 w-10 rounded-full bg-base-300"></div>
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-lg font-semibold" x-text="mode === 'edit' ? labels.edit : labels.create"></h2>
      <button type="button" class="btn btn-ghost btn-sm btn-circle" @click="close()" aria-label={t("close")}
        >✕</button
      >
    </div>

    {/* Create form */}
    <form
      method="POST"
      action={createAction}
      class="flex flex-col gap-4"
      x-show="mode === 'create'"
    >
      <label class="form-control w-full">
        <div class="label py-1"><span class="label-text font-medium">{t("startTime")}</span></div>
        <select class="select select-bordered w-full" name="startsAt" x-model="startsAt" required>
          {
            slotsByDay.map((day) => (
              <optgroup label={day.label}>
                {day.slots.map((slot) => (
                  <option value={slot.value}>{slot.label}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </label>

      <label class="form-control w-full">
        <div class="label py-1"><span class="label-text font-medium">{t("duration")}</span></div>
        <select
          class="select select-bordered w-full"
          name="durationMin"
          x-model.number="durationMin"
          required
        >
          <option value="30">{t("minutes30")}</option>
          <option value="60">{t("minutes60")}</option>
        </select>
      </label>

      <p class="text-sm text-base-content/60">{t("openHours", { open: OPEN_HOUR, close: CLOSE_HOUR })}</p>

      <div class="flex gap-2 pt-2">
        <button type="button" class="btn btn-ghost flex-1" @click="close()">{t("cancel")}</button>
        <button type="submit" class="btn btn-primary flex-1">{t("save")}</button>
      </div>
    </form>

    {/* Edit form */}
    <form
      method="POST"
      action={updateAction}
      class="flex flex-col gap-4"
      x-show="mode === 'edit'"
      x-cloak
    >
      <input type="hidden" name="id" :value="bookingId" />
      <label class="form-control w-full">
        <div class="label py-1"><span class="label-text font-medium">{t("startTime")}</span></div>
        <select class="select select-bordered w-full" name="startsAt" x-model="startsAt" required>
          {
            slotsByDay.map((day) => (
              <optgroup label={day.label}>
                {day.slots.map((slot) => (
                  <option value={slot.value}>{slot.label}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </label>

      <label class="form-control w-full">
        <div class="label py-1"><span class="label-text font-medium">{t("duration")}</span></div>
        <select
          class="select select-bordered w-full"
          name="durationMin"
          x-model.number="durationMin"
          required
        >
          <option value="30">{t("minutes30")}</option>
          <option value="60">{t("minutes60")}</option>
        </select>
      </label>

      <div class="flex gap-2 pt-2">
        <button type="button" class="btn btn-ghost flex-1" @click="close()">{t("cancel")}</button>
        <button type="submit" class="btn btn-primary flex-1">{t("save")}</button>
      </div>
    </form>

    <form
      method="POST"
      action={deleteAction}
      class="mt-3"
      x-show="mode === 'edit'"
      x-cloak
      onsubmit={`return confirm(${JSON.stringify(t("confirmCancelBooking"))})`}
    >
      <input type="hidden" name="id" :value="bookingId" />
      <button type="submit" class="btn btn-outline btn-error w-full">{t("cancelBooking")}</button>
    </form>
  </div>
</div>
